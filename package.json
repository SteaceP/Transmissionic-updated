{
  "name": "transmissionic",
  "version": "2.0.0",
  "desktopName": "com.steacep.transmissionic.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/SteaceP/Transmissionic-updated"
  },
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "eslint .",
    "build:webui": "npm run prebuild:webui && npm run build && npm run postbuild:webui",
    "prebuild:webui": "node scripts/prebuild-webui.js",
    "postbuild:webui": "node scripts/postbuild-webui.js",
    "postbuild:electron": "node scripts/postbuild-electron.js",
    "sync:electron": "npm run build && npx cap sync @capacitor-community/electron && npm run postbuild:electron",
    "sync:android": "npm run build && npx cap sync android",
    "sync:ios": "npm run build && npx cap sync ios",
    "build:iphonesimulator": "npm run build && npx cap sync ios && xcodebuild -sdk iphonesimulator -workspace ios/App/App.xcworkspace/ -scheme App -configuration Debug"
  },
  "dependencies": {
    "@byteowls/capacitor-filesharer": "^7.0.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-reader": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capacitor/toast": "^8.0.1",
    "@ionic/pwa-elements": "^3.4.0",
    "@ionic/vue": "^9.0.10",
    "@ionic/vue-router": "^9.0.10",
    "@types/vue-virtual-scroller": "npm:@earltp/vue-virtual-scroller@^1.0.1",
    "autolinker": "^4.1.5",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "chart.js": "^4.6.1",
    "core-js": "^3.51.0",
    "localized-strings": "^2.1.2",
    "make-plural": "^8.2.0",
    "mitt": "^3.0.1",
    "moment": "^2.31.0",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "parse-torrent": "^11.0.24",
    "swiper": "^14.4.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-virtual-scroller": "^3.0.5"
  },
  "devDependencies": {
    "@capacitor-community/electron": "^5.0.1",
    "@capacitor/cli": "^8.6.0",
    "@types/lodash": "^4.17.27",
    "@types/parse-torrent": "^11.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-plugin-eslint": "^5.0.9",
    "@vue/cli-plugin-router": "~5.0.9",
    "@vue/cli-plugin-typescript": "^5.0.9",
    "@vue/cli-service": "~5.0.9",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-webpack-plugin": "^6.0.0",
    "typescript": "~6.0.3"
  },
  "description": "Remote for Transmission Daemon",
  "allowScripts": {
    "yorkie@2.0.0": true,
    "core-js@3.51.0": true,
    "core-js@2.6.12": true
  }
}
